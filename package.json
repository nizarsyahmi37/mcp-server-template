{
	"name": "@nizarsyahmi37/mcp-server-template",
	"version": "0.1.0",
	"description": "A starter template for building your own MCP (Model Context Protocol) server in TypeScript.",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"mcp-server",
		"typescript",
		"template",
		"boilerplate",
		"starter"
	],
	"author": "nizarsyahmi37 (https://github.com/nizarsyahmi37)",
	"homepage": "https://github.com/nizarsyahmi37/mcp-server-template#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nizarsyahmi37/mcp-server-template.git"
	},
	"bugs": {
		"url": "https://github.com/nizarsyahmi37/mcp-server-template/issues"
	},
	"type": "module",
	"license": "MIT",
	"main": "dist/index.js",
	"bin": {
		"mcp-server-template": "dist/index.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.js",
		"start:http": "node dist/http.js",
		"dev:http": "tsx watch src/http.ts",
		"inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts",
		"typecheck": "tsc --noEmit",
		"test": "tsx --test test/*.test.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0"
	}
}
