# Copy to .env and adjust. Never commit real secrets.
PORT=3000
# Address the HTTP server binds to. Defaults to loopback.
# HOST=127.0.0.1
# Require "Authorization: Bearer <token>" on the HTTP endpoint.
# Generate one with: openssl rand -hex 32
# MCP_AUTH_TOKEN=
# Example of a secret your tools might need:
# MY_API_KEY=
